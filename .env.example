# NewsC environment — copy to .env and adjust

# PostgreSQL (local socket recommended；用户名改成本机 OS 用户)
DATABASE_URL=postgresql+psycopg://qiubin@/newsc?host=/tmp

# Orchestrator
ORCH_PORT=8787
ORCH_HOST=127.0.0.1
LOG_LEVEL=INFO
# 非空时写接口需 Authorization: Bearer <token> 或 X-API-Token
# 云端 Web 经 /api 代理自动注入，勿配置 NEXT_PUBLIC_ 暴露 token
# ORCH_API_TOKEN=
# CORS：默认按 WEB_PORT 自动放行 127.0.0.1/localhost；需要时再显式追加
# ORCH_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# AI module
AI_MOCK_MODE=true
AI_PROVIDER=mock
# 真服务（优先 MiniMax Coding Plan / 国内）：
# AI_MOCK_MODE=false
# AI_PROVIDER=minimax
# MINIMAX_CODING_API_KEY=   # sk-cp-… 优先
# MINIMAX_API_KEY=          # sk-api-… 普通 Key
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M3
# 国际站可用：https://api.minimax.io/v1
# AI_PROVIDER=openclaw
# OpenClaw 失败时是否禁止静默 Mock（true=抛错）
# AI_FALLBACK_STRICT=false
# AI job 最大重试次数 / running 超时回收（秒）
# AI_JOB_MAX_ATTEMPTS=3
# AI_JOB_STALE_RUNNING_SEC=900

# OpenClaw Gateway (only when AI_PROVIDER=openclaw)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=

# Web
# 本机开发直连 API；云端混合部署用 /api（Next rewrite → ORCH_INTERNAL_URL）
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787
# ORCH_INTERNAL_URL=http://127.0.0.1:8787
WEB_PORT=3000

# 日报 HTML vault（相对仓库根或绝对路径；个人源见 digest-sources.local.yml）
# DIGEST_SOURCES_FILE=digest-sources.yml

# Digest CLI（可选兼容；主路径已改为 vault 直读）
# NEWSC_API_URL=http://127.0.0.1:8787

# 云端库同步（本机真源 → 云副本；真密写在 .env.cloud.local，也可在设置页配置）
# DEPLOY_HOST=120.25.145.131
# DEPLOY_DIR=/opt/newsc
# NEWSC_TUNNEL_LOCAL_PORT=15434
# CLOUD_DATABASE_URL=postgresql://newsc:密码@127.0.0.1:15434/newsc
# LOCAL_DATABASE_URL=postgresql://qiubin@/newsc?host=/tmp
# 定时推送（Mac LaunchAgent）
# PUSH_SCHEDULE_ENABLED=1
# PUSH_SCHEDULE_MODE=daily
# PUSH_SCHEDULE_TIMES=08:25,12:15,18:25,21:15
# PUSH_SCHEDULE_INTERVAL_HOURS=6
