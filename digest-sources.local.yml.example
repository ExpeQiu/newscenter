# 复制为 digest-sources.local.yml 后按本机路径修改（勿提交）
# 与 digest-sources.yml 按 id 合并，同 id 时 local 覆盖。
# refresh_interval：15m|30m|1h|3h|6h|12h|1d|manual

sources:
- id: ai-tech
  label: AI技术日报
  path: /path/to/your/AI技术日报/技术日报html
  enabled: true
  refresh_interval: 1d
- id: knowledge-daily
  label: 每日知识日报
  path: /path/to/your/每日知识日报/每日知识日报html
  enabled: true
  refresh_interval: 1d
